{
  "version": 2,
  "buildCommand": "echo Static classroom dashboard - using committed report snapshot",
  "outputDirectory": "dashboard",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "source/**"
    },
    "api/lab-worker.py": {
      "maxDuration": 300,
      "includeFiles": "{pipeline/**,schemas/**,dashboard/data/classroom_source_contract.json}"
    }
  }
}
